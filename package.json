{
  "name": "maimai-random-pro",
  "version": "2.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/sync-theme.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint src",
    "dist:win": "npm run build && npm run dist:portable",
    "dist:portable": "powershell -NoProfile -File scripts/build-portable.ps1"
  },
  "dependencies": {
    "lucide-react": "0.511.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ws": "8.21.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "9.25.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.4.1",
    "eslint": "9.25.0",
    "eslint-plugin-react-hooks": "5.2.4",
    "globals": "16.0.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.30.1",
    "vite": "6.3.5"
  },
  "description": "轻量 maimai 抽谱与赛事工具，支持定数筛选、名单导入和 OBS 同步",
  "author": "maimai Random Pro contributors"
}
